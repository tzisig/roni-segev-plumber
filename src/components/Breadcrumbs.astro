---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[]; dark?: boolean }
const { crumbs, dark = false } = Astro.props;
---
<nav class:list={['crumbs', { dark }]} aria-label="מיקום בעמוד">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0 0 var(--space-4); padding: 0; font-size: 0.9rem; color: var(--c-muted); }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.35rem; opacity: 0.6; }
  .crumbs a { color: inherit; }
  .dark ol { color: var(--c-on-dark-muted); }
</style>
