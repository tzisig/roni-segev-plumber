---
// Dark blueprint hero for inner pages: breadcrumbs, title, lead, call buttons, optional image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CallButtons from './CallButtons.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Show call and WhatsApp buttons under the lead. */
  cta?: boolean;
  whatsappText?: string;
}
const { eyebrow, title, lead, crumbs, image, imageAlt = '', cta = true, whatsappText } = Astro.props;
---
<section class:list={['page-hero blueprint on-dark', { 'has-image': image }]}>
  <div class="container inner">
    <div class="copy">
      <Breadcrumbs crumbs={crumbs} dark />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
      {cta && <CallButtons whatsappText={whatsappText} />}
    </div>
    {image && (
      <div class="media">
        <Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(min-width: 1000px) 480px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { color: #fff; padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); position: relative; overflow: hidden; }
  .page-hero::after {
    content: ''; position: absolute; inset-inline-end: -120px; bottom: -120px; width: 360px; height: 360px;
    border-radius: 50%; background: radial-gradient(closest-side, rgb(255 122 26 / 0.28), transparent); pointer-events: none;
  }
  .inner { display: grid; gap: var(--space-6); align-items: center; position: relative; z-index: 1; }
  h1 { max-width: 20ch; }
  .lead { color: var(--c-on-dark-muted); max-width: 42rem; }
  .media { border-radius: var(--radius-l); overflow: hidden; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6); border: 1px solid rgb(255 255 255 / 0.12); }
  .media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 1000px) {
    .has-image .inner { grid-template-columns: 1.25fr 1fr; }
  }
</style>
