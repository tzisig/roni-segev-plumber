---
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import { areaBySlug, serviceBySlug, type Testimonial } from '../config/site.config';

interface Props { t: Testimonial }
const { t } = Astro.props;
const area = areaBySlug(t.area);
const service = serviceBySlug(t.service);
const date = new Date(t.date + '-01T00:00:00').toLocaleDateString('he-IL', { month: 'long', year: 'numeric' });
---
<figure class="t-card">
  <div class="top">
    <Stars rating={t.rating} />
    <Icon name="quote" size={28} class="q" />
  </div>
  <blockquote><p>{t.text}</p></blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
    <span class="who">
      <strong>{t.name}</strong>
      <span>{t.neighborhood}{area && area.name !== t.neighborhood ? `, ${area.name}` : ''} · {date}</span>
    </span>
  </figcaption>
  {service && <a class="svc" href={`/services/${service.slug}/`}>{service.navTitle}</a>}
</figure>

<style>
  .t-card {
    margin: 0; display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; background: #fff;
    border: 1px solid var(--c-line); border-radius: var(--radius-l); box-shadow: var(--shadow-1); height: 100%;
  }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .top :global(.q) { color: var(--c-orange); opacity: 0.35; }
  blockquote { margin: 0; flex: 1; }
  blockquote p { margin: 0; font-size: 1.05rem; }
  figcaption { display: flex; align-items: center; gap: 0.75rem; }
  .avatar {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--c-ink); color: #fff; font: 700 1.1rem var(--font-display); flex: none;
  }
  .who { display: grid; line-height: 1.3; }
  .who span { font-size: 0.9rem; color: var(--c-muted); }
  .svc { align-self: flex-start; font-size: 0.85rem; font-weight: 600; padding: 0.25rem 0.7rem; border-radius: 999px; background: var(--c-blue-soft); color: var(--c-ink); text-decoration: none; }
  .svc:hover { background: var(--c-orange-soft); }
</style>
