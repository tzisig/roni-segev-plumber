---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AreaMap from '../../components/AreaMap.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, contact, images } from '../../config/site.config';
import { breadcrumbSchema, home } from '../../lib/schema';

const crumbs = [home, { label: 'אזורי שירות' }];
---
<BaseLayout
  title="אזורי שירות: חיפה, קריית אתא, ביאליק, מוצקין וקריית ים"
  description={`רוני שגב מגיע לכל חיפה והקריות: קריית אתא, קריית ביאליק, קריית מוצקין וקריית ים. זמני הגעה של ${contact.arrival.min}-${contact.arrival.max} דקות, 24/7.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="אזורי שירות"
    title="חיפה והקריות, מכל פינה"
    lead={`הרכב של רוני יוצא כל יום מ${contact.baseArea}, באמצע המפרץ. כך אפשר להגיע לכל אחד מהאזורים תוך דקות, גם בלילה.`}
    crumbs={crumbs}
    image={images.areas}
    imageAlt={images.areasAlt}
  />

  <section class="section section--dark blueprint">
    <div class="container">
      <h2 class="visually-hidden">מפת אזורי השירות</h2>
      <AreaMap headingLevel="h3" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">עמוד לכל אזור</p>
        <h2>מה מיוחד בצנרת בכל עיר</h2>
        <p>כל אזור מביא איתו בעיות אחרות: מדרונות בכרמל, אוויר ים בקריית ים, שורשים בחצרות של קריית ביאליק. בחרו את האזור שלכם.</p>
      </div>
      <div class="grid grid--3">
        {areas.map((a, i) => (
          <article class="area-card reveal" data-delay={String(i % 3)}>
            <Image src={a.image} alt="" widths={[400, 640]} sizes="(min-width: 1000px) 380px, 100vw" />
            <div class="body">
              <h3><a href={`/areas/${a.slug}/`}>אינסטלטור {a.nameIn}</a></h3>
              <p>{a.intro}</p>
              <span class="eta"><Icon name="truck" size={16} />{a.eta.min}-{a.eta.max} דקות</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .area-card { position: relative; border-radius: var(--radius-l); overflow: hidden; border: 1px solid var(--c-line); background: #fff; box-shadow: var(--shadow-1); transition: transform 220ms var(--ease), box-shadow 220ms; }
  .area-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .area-card :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { padding: 1.25rem 1.35rem 1.4rem; }
  h3 a { color: var(--c-ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .area-card:focus-within { outline: 3px solid var(--c-orange); outline-offset: 3px; }
  h3 a:focus-visible { outline: none; }
  .body p { color: var(--c-muted); }
  .eta { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--c-orange-deep); font-size: 0.95rem; }
</style>
